{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "openrouter-models",
  "title": "OpenRouter Models",
  "description": "Browse and search OpenRouter AI models",
  "icon": "extension-icon.png",
  "author": "mikedemarais",
  "categories": [
    "Developer Tools",
    "Documentation"
  ],
  "license": "MIT",
  "commands": [
    {
      "name": "list-models",
      "title": "OpenRouter Models",
      "description": "View available AI models",
      "mode": "view"
    }
  ],
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "OpenRouter API Key",
      "description": "Your OpenRouter API key for accessing models"
    }
  ],
  "dependencies": {
    "@raycast/api": "^1.92.0",
    "@raycast/utils": "^1.17.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^1.0.11",
    "@types/lodash": "^4.14.202",
    "@types/node": "20.8.10",
    "@types/react": "18.3.3",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "typescript": "^5.4.5"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "typecheck": "tsc --noEmit",
    "publish": "npx @raycast/api@latest publish"
  }
}